# Copie para .env.whatsapp.local na raiz do projeto. Este arquivo de exemplo não contém chaves.
EVOLUTION_URL=http://localhost:8080
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
WHATSAPP_GROUP_JID=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_FOOD_PORT=8787
