# WHATSAPP_WEBHOOK_URL=http://host.docker.internal:8787/webhook/SEU_SEGREDO
# Opcional se o Codex CLI não estiver no local padrão do npm:
# CODEX_CLI_JS=C:\Users\voce\AppData\Roaming\npm\node_modules\@openai\codex\bin\codex.js
SUPABASE_URL=
SUPABASE_SECRET_KEY=
BCTRL_USER_ID=
